# Template for .env - copy to .env and fill in real values.
#   cp .env.example .env
# Generate a SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_hex(32))"

APP_ENV=development
SECRET_KEY=replace-me-with-a-random-hex-string

# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://expense_user:expense_pass@localhost:5434/expense_tracker

# Optional - the test suite defaults to expense_tracker_test on the same server.
# TEST_DATABASE_URL=postgresql+psycopg://expense_user:expense_pass@localhost:5434/expense_tracker_test

# Login - see README, "Login (Auth0)". Neither value is a secret.
# Your Auth0 tenant domain, without https://
AUTH0_DOMAIN=your-tenant.eu.auth0.com
# APIs > Spendora API > Identifier. Must equal VITE_AUTH0_AUDIENCE in frontend/.env.local
AUTH0_AUDIENCE=https://api.spendora
