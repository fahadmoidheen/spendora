# Auth0 settings for the browser. Copy this file to .env.local (git ignores
# *.local) and fill in the values from your Auth0 dashboard - see README,
# "Login (Auth0)". None of these are secrets. Restart `npm run dev` after
# changing them.

VITE_AUTH0_DOMAIN=your-tenant.eu.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://api.spendora